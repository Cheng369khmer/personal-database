@page
@model MyPortfolio.Pages.Account.RegisterModel
@{
    Layout = null;
    ViewData["Title"] = "Register";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register – CHENG IT</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Sora:wght@300;400;600;700;800&display=swap" rel="stylesheet" />
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet' />
</head>
<body>
<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">
            <div style="font-size:2.5rem;">✨</div>
            <h2>Create Account</h2>
            <p class="muted" style="font-size:.85rem;">Join abu.said portfolio</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" asp-for="FullName" placeholder="John Doe" required />
            </div>
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" asp-for="Email" placeholder="john@example.com" required />
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label>Password</label>
                    <input type="password" asp-for="Password" placeholder="Min 8 chars" required />
                </div>
                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password" asp-for="ConfirmPassword" placeholder="Repeat password" required />
                </div>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:.5rem;">
                <i class='bx bx-user-plus'></i> Create Account
            </button>
        </form>

        <div style="text-align:center;margin-top:1.5rem;padding-top:1.5rem;border-top:1px solid var(--border);">
            <p class="muted" style="font-size:.85rem;">
                Already have an account? <a href="/Account/Login">Sign in</a>
            </p>
            <a href="/" class="muted" style="font-size:.85rem;">← Back to Portfolio</a>
        </div>
    </div>
</div>
</body>
</html>
